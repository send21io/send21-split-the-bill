# Copy to .env. Real environment variables win. Never commit .env.

# send21: scoped API key from https://send21.io/api-keys (drafts:write).
# Leave empty for mock mode: no calls to send21, a local mock pay page.
SEND21_API_KEY=
# Signing secret, shown once when you create the webhook (npm run webhook:register).
SEND21_WEBHOOK_SECRET=
# Optional, defaults to https://send21.io
# SEND21_API_BASE=https://send21.io

PORT=3000
# Public HTTPS address of this app (send21 refuses private webhook addresses).
PUBLIC_URL=https://split.example.com
# Set to 1 behind a reverse proxy, so rate limits see the real client IP.
TRUST_PROXY=0

# Pay links stay open this long (1-720 hours)
SPLIT_EXPIRY_HOURS=72
# Accept payments up to this many percent short automatically (0-10, exchange fees)
SPLIT_SHORTFALL_PERCENT=2
DATA_FILE=./data/split.json
